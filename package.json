{
  "name": "json-storage-formatter",
  "version": "4.0.0",
  "description": "Package for json stringify objects without losing data types",
  "main": "./bundle.js",
  "module": "./bundle.mjs",
  "types": "./bundle.d.ts",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./bundle.d.ts",
      "import": "./bundle.mjs",
      "require": "./bundle.cjs"
    },
    "./isNil": {
      "types": "./isNil.d.ts",
      "import": "./isNil.mjs",
      "require": "./isNil.cjs"
    },
    "./isNumber": {
      "types": "./isNumber.d.ts",
      "import": "./isNumber.mjs",
      "require": "./isNumber.cjs"
    },
    "./isBoolean": {
      "types": "./isBoolean.d.ts",
      "import": "./isBoolean.mjs",
      "require": "./isBoolean.cjs"
    },
    "./isString": {
      "types": "./isString.d.ts",
      "import": "./isString.mjs",
      "require": "./isString.cjs"
    },
    "./isDate": {
      "types": "./isDate.d.ts",
      "import": "./isDate.mjs",
      "require": "./isDate.cjs"
    },
    "./isRegex": {
      "types": "./isRegex.d.ts",
      "import": "./isRegex.mjs",
      "require": "./isRegex.cjs"
    },
    "./isFunction": {
      "types": "./isFunction.d.ts",
      "import": "./isFunction.mjs",
      "require": "./isFunction.cjs"
    },
    "./isPrimitive": {
      "types": "./isPrimitive.d.ts",
      "import": "./isPrimitive.mjs",
      "require": "./isPrimitive.cjs"
    },
    "./types": {
      "types": "./types.d.ts",
      "import": "./types.mjs",
      "require": "./types.cjs"
    },
    "./formatFromStore": {
      "types": "./formatFromStore.d.ts",
      "import": "./formatFromStore.mjs",
      "require": "./formatFromStore.cjs"
    },
    "./formatToStore": {
      "types": "./formatToStore.d.ts",
      "import": "./formatToStore.mjs",
      "require": "./formatToStore.cjs"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "./*.js",
    "./*.cjs",
    "./*.mjs",
    "./*.d.ts"
  ],
  "scripts": {
    "format": "prettier --write .  --log-level silent && yarn lint:fix",
    "test": "yarn build && yarn jest",
    "test:debug:no-watch": "node --inspect-brk node_modules/.bin/jest --no-watchman --runInBand",
    "test:debug": "node --inspect-brk node_modules/.bin/jest --watch --runInBand",
    "test:quick": "yarn jest --no-coverage --maxWorkers=4 -c --no-watchman -u",
    "test:coverage": "yarn jest --maxWorkers=4 -c --colors --no-watchman --verbose --coverage",
    "test:interop": "tsx scripts/test-interop.ts",
    "build": "yarn ts-check && yarn clean && tsx scripts/build.ts && tsx scripts/prepare-dist.ts",
    "prepare-dist": "tsx scripts/prepare-dist.ts",
    "publish:pkg": "yarn build && cd dist && npm publish --registry https://registry.npmjs.org/",
    "publish:beta": "yarn build && cd dist && npm publish --tag beta --registry https://registry.npmjs.org/",
    "prepare": "yarn format && yarn build && yarn test:quick",
    "version": "yarn format && yarn build && yarn jest && git add -A",
    "postversion": "git push && git push --tags",
    "lint": "eslint . --max-warnings=0",
    "lint:fix": "eslint . --fix --max-warnings=0",
    "clean": "rm -rf dist coverage",
    "ts-check": "tsc -p tsconfig.json --noEmit"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/johnny-quesada-developer/json-storage-formatter.git"
  },
  "keywords": [
    "json",
    "state",
    "typescript",
    "storage",
    "asynstorage",
    "localstorage"
  ],
  "author": "johnny quesada",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/johnny-quesada-developer/json-storage-formatter/issues"
  },
  "homepage": "https://github.com/johnny-quesada-developer/json-storage-formatter#readme",
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@types/jest": "^26.0.17",
    "@types/node": "^22.20.2",
    "@typescript-eslint/eslint-plugin": "^4.9.1",
    "@typescript-eslint/parser": "^4.9.1",
    "esbuild": "^0.28.2",
    "eslint": "^9.39.1",
    "eslint-config-airbnb": "^18.2.1",
    "eslint-plugin-import": "^2.22.1",
    "eslint-plugin-jsx-a11y": "^6.4.1",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^4.2.0",
    "jest": "^29.3.1",
    "prettier": "^3.6.2",
    "ts-jest": "^29.0.3",
    "tsx": "^4.23.13",
    "typescript": "^4.1.2",
    "typescript-eslint": "^8.46.3"
  }
}
